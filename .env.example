# FedaPay production API keys. The secret key must remain on the backend.
# The hosted payment link flow uses the secret key; the public key is reserved for client-side FedaPay integrations.
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=live
# Endpoint signing secret from the FedaPay webhook settings (different from API keys).
FEDAPAY_WEBHOOK_SECRET=
# ISO 3166-1 alpha-2 country code used with the optional customer phone number.
FEDAPAY_COUNTRY=TG
APP_BASE_URL=
BACKEND_PUBLIC_URL=
